# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.
# La app NO arranca si los secretos faltan, valen "cambiame" o son demasiado cortos.
PORT=3000
DATA_DIR=/app/data
TZ=Europe/Madrid

# Genera cada secreto con:  openssl rand -hex 32   (mínimo 32 caracteres)
SESSION_SECRET=cambiame
PIN_HMAC_SECRET=cambiame

# Administrador inicial (solo se usa la primera vez que arranca con la base vacía).
# La contraseña debe tener al menos 10 caracteres; cámbiala desde el panel tras entrar.
ADMIN_USER=admin
ADMIN_PASSWORD_INITIAL=cambiame

# Saltos de proxy entre el cliente y la app (para obtener la IP real y el esquema https):
#   2 = Cloudflare (nube naranja) + Nginx Proxy Manager   <- configuración actual
#   1 = solo Nginx Proxy Manager (DNS sin proxy de Cloudflare)
#   0 = sin proxy (acceso directo)
TRUST_PROXY=2

# Día de las elecciones (AAAA-MM-DD, hora de Madrid). Modo de trabajo automático:
#   antes de esa fecha  -> DEMO (datos de prueba en data/demo.db, se descartan al pasar a REAL)
#   desde las 00:00 de ese día -> REAL (datos reales en data/app.db); anula cualquier modo manual
# Se puede forzar a mano desde el panel (Modo de trabajo). Comprueba que la hora del servidor es la de Madrid.
ELECTION_DATE=2026-11-29

# Cookies "Secure" (necesarias tras HTTPS). Pon false SOLO para pruebas en local por http.
COOKIE_SECURE=true
